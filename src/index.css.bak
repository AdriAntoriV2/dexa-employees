@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #302a29;
  background: #f3f1ef;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  font-optical-sizing: auto;
  font-weight: 400;

  color-scheme: light;

  --color-brand: #a52823;
  --color-brand-hover: #84201d;
  --color-brand-soft: #f4e8e6;

  --color-background: #f3f1ef;
  --color-surface: #ffffff;
  --color-surface-muted: #eae4e1;

  --color-sidebar: #292323;
  --color-sidebar-hover: #403332;

  --color-text: #302a29;
  --color-text-muted: #756c69;
  --color-border: #e5dfdc;

  --color-success: #28734a;
  --color-warning: #94641c;
  --color-danger: #a52823;

  --shadow-card: 0 3px 12px rgb(48 42 41 / 5%);
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  min-height: 100%;
  background: var(--color-background);
}

body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
  background: var(--color-background);
  color: var(--color-text);
}

button,
input,
textarea,
select {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 3px solid #c66c66;
  outline-offset: 3px;
}

::selection {
  color: #ffffff;
  background: var(--color-brand);
}